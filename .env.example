# Whisper server: POST multipart file=<wav> -> {"text", "language"}, bearer auth
STT_URL=http://your-server:8080/transcribe
STT_KEY=
# OpenAI-compatible chat endpoint, used to romanize Hindi into Hinglish
LLM_URL=http://your-server:8000/v1/chat/completions
LLM_MODEL=model
# Optional. Only hosted APIs need a key (DeepSeek: LLM_URL=https://api.deepseek.com/chat/completions,
# LLM_MODEL=deepseek-chat). A cloud LLM sees your Hindi text, see the README warning.
LLM_KEY=
# Optional. Start/stop shortcut; easiest to change from the tray menu.
# A combo (win+space, ctrl+alt+d) or one key (ctrl_r, alt_r, f8, insert, scroll_lock, pause).
HOTKEY=win+space
# Optional. Mic level that counts as speech. Raise it if pauses are missed in a noisy room,
# lower it if you get "Didn't hear you" while talking.
SPEECH_RMS=0.015
# Optional. Seconds of silence after speech that end the session (it waits longer if you
# take long pauses, up to 15 s). 0 = stop only with the shortcut.
AUTO_STOP_S=6
# Optional. 0 turns off pulling the latest version from git on start.
AUTO_UPDATE=1
